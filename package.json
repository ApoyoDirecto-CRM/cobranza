{
  "name": "cobranza",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de Gestion de Cobranza y Portal de Clientes (standalone)",
  "workspaces": [
    "api",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v",
    "db:migrate": "npm run db:migrate -w api",
    "db:seed": "npm run db:seed -w api",
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w api && npm run build -w web",
    "start": "npm run start -w api",
    "test": "npm run test -w api",
    "typecheck": "npm run typecheck -w api && npm run typecheck -w web"
  },
  "devDependencies": {
    "npm-run-all": "4.1.5",
    "typescript": "5.9.3"
  }
}
