# ---------------------------------------------------------------------------
# COBRANZA - Variables de entorno
# Copia este archivo a `.env` y ajusta los valores. NUNCA subas `.env` a git.
# ---------------------------------------------------------------------------

# --- Motor de base de datos -------------------------------------------------
# postgres : `pg` contra DATABASE_URL. Es el valor por defecto y el de produccion.
# pglite   : levanta PostgreSQL 18 (WASM) DENTRO del proceso. Sirve para probar
#            el sistema completo en local sin Docker ni servidor PostgreSQL, y se
#            rechaza si NODE_ENV=production.
DB_DRIVER=postgres

# --- Base de datos (PostgreSQL) --------------------------------------------
# Solo hace falta con DB_DRIVER=postgres.
# Si usas el docker-compose incluido, esta es la URL por defecto:
DATABASE_URL=postgres://cobranza:cobranza_dev_pwd@localhost:5432/cobranza
# Requiere TLS en produccion: ?sslmode=require
PGPOOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=8000

# Solo con DB_DRIVER=pglite. Vacio = base EN MEMORIA (nace limpia en cada
# arranque, como el primer despliegue en Render). Un directorio la conserva
# entre reinicios; la ruta es relativa al cwd del proceso (api/).
PGLITE_DATA_DIR=

# --- API --------------------------------------------------------------------
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
# Orígenes permitidos por CORS, separados por coma.
# Si se deja VACIO significa "despliegue de un solo origen": el portal y la API
# comparten dominio y se rechaza todo lo cross-origin (lo correcto en Render).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Sirviendo el frontend --------------------------------------------------
# En produccion la API sirve tambien el build del portal: un solo proceso, un
# solo origen y un solo arranque en frio. En desarrollo lo sirve Vite y esto se
# desactiva solo (no existe web/dist todavia).
SERVE_WEB=true
WEB_DIST_PATH=web/dist

# --- Migraciones ------------------------------------------------------------
# AUTO_MIGRATE las ejecuta al arrancar el proceso.
# Necesario en Render gratuito: `preDeployCommand` es de pago y el servicio se
# reinicia muchas veces al dia por el cold start. Son idempotentes.
# Por defecto se activan solos con DB_DRIVER=pglite, donde la base nace vacia.
AUTO_MIGRATE=false
# Inserta datos de demostracion SOLO si la base esta vacia.
SEED_ON_DEPLOY=false

# Secretos (genera con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
# Ambos deben ser distintos y de al menos 32 caracteres.
JWT_ACCESS_SECRET=cambiame_en_produccion_secret_acceso_min_32_chars
JWT_REFRESH_SECRET=cambiame_en_produccion_secret_refresh_min_32_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- Seguridad del portal (login telefono + DNI/CURP) ----------------------
# Maximo de intentos fallidos por telefono antes de bloquear temporalmente.
PORTAL_MAX_FAILED_ATTEMPTS=5
PORTAL_LOCKOUT_MINUTES=15
# Ventana (minutos) para el rate limit global por IP sobre /auth/login.
PORTAL_LOGIN_RATE_LIMIT=10

# Segundo factor por SMS. Con true, /auth/login NO emite tokens: genera un
# codigo de un solo uso y hay que llamar a /auth/verify-otp.
PORTAL_OTP_ENABLED=true
# console = imprime el codigo en el log del servidor (solo desarrollo/pruebas).
# twilio  = envia SMS real (requiere TWILIO_* abajo).
PORTAL_OTP_PROVIDER=console
PORTAL_OTP_TTL_MINUTES=5
# Solo con PORTAL_OTP_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Pepper del indice ciego de CURP/DNI (SHA-256). Debe ser propio y secreto en
# produccion. Si lo cambias, los clientes existentes dejan de detectarse como
# duplicados: fijalo ANTES del primer despliegue y no lo rotes sin migracion.
IDENTITY_PEPPER=cambiame_en_produccion_identity_pepper_min_32_chars

# --- Admin ------------------------------------------------------------------
# Semilla del usuario administrador inicial (cambiar en el primer login).
SEED_ADMIN_EMAIL=admin@cobranza.local
SEED_ADMIN_PASSWORD=CambiarEstePassword1!

# --- Pasarela de pago / SPEI ----------------------------------------------
# Secreto compartido para validar la firma HMAC del webhook entrante.
WEBHOOK_SECRET=cambiame_en_produccion_webhook_secret
# Tolerancia (segundos) contra ataques de repeticion.
WEBHOOK_TOLERANCE_SECONDS=300
# Datos de la cuenta SPEI designada que recibe las transferencias.
# El titular lo VE el cliente en su app bancaria: abre la cuenta a nombre de un
# negocio/marca, nunca de una persona. No se puede enmascarar.
SPEI_BANCO=BBVA Bancomer
SPEI_CLABE=012180001234567899
SPEI_TITULAR=CUENTA RECEPTORA DEMO
SPEI_CONCEPTO_REF=FOLIO-{FOLIO}
SPEI_TIEMPO_LIMITE_HORAS=72
# Clave publica de la pasarela para cifrar los datos de tarjeta al crear un cargo.
GATEWAY_MERCHANT_ID=
GATEWAY_PUBLIC_KEY=
GATEWAY_API_BASE=https://api.pasarela.example.com/v1

# --- Frontend (Vite) --------------------------------------------------------
# OJO: Vite incrusta las variables VITE_* en el bundle al compilar. Cambiarlas
# despues exige volver a construir.
# Si el frontend se sirve en el mismo origen que la API, deja el valor por
# defecto y configura el proxy de Vite (ver web/vite.config.ts).
VITE_API_BASE_URL=/api/v1
# Destino del proxy en desarrollo (solo para Vite, no se incrusta en el bundle):
VITE_DEV_API_TARGET=http://localhost:3000
